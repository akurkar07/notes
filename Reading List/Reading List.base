filters:
  and:
    - note["base"] == link("Reading List.base")
properties:
  file.name:
    displayName: Title
  Genre:
    displayName: Genre
  Subgenre:
    displayName: Subgenre
  Author:
    displayName: Author
  Status:
    displayName: Status
views:
  - type: table
    name: To Read
    filters:
      and:
        - Status != "Completed"
    groupBy:
      property: Genre
      direction: ASC
    order:
      - file.name
      - Genre
      - Subgenre
      - Author
      - Status
    sort:
      - property: Status
        direction: DESC
      - property: Subgenre
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Completed
    filters:
      and:
        - Status == "Completed"
    groupBy:
      property: Genre
      direction: ASC
    order:
      - file.name
      - Genre
      - Subgenre
      - Author
      - Status
    sort:
      - property: Subgenre
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: All Books
    groupBy:
      property: Genre
      direction: ASC
    order:
      - file.name
      - Genre
      - Subgenre
      - Author
      - Status
    sort:
      - property: Genre
        direction: ASC
      - property: Subgenre
        direction: ASC
      - property: file.name
        direction: ASC
  - type: cards
    name: View
