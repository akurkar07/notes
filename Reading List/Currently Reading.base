filters:
  and:
    - note["base"] == link("Reading List.base")
    - Status == "Reading"
properties:
  file.name:
    displayName: Title
  Genre:
    displayName: Genre
  Subgenre:
    displayName: Subgenre
  Author:
    displayName: Author
  Status:
    displayName: Status
views:
  - type: table
    name: Current
    order:
      - file.name
      - Genre
      - Subgenre
      - Author
      - Status
